{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:redact-secret-benchmarks:support-matrix:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taxonomySchemaVersion", "sourceReport", "providerCount", "familyCount", "distribution", "stableDistribution", "families", "findingTypeSource", "piiQualification", "piiDistribution", "piiFamilies"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taxonomySchemaVersion": { "const": 1 },
    "sourceReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "generatedAt", "runId", "revision", "dirty", "criteriaSchemaVersion", "fixtureIndex", "taxonomyDigest", "scannerObservations"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "generatedAt": { "type": "string" },
        "runId": { "type": "string" },
        "revision": { "type": "string" },
        "dirty": { "type": ["boolean", "null"] },
        "criteriaSchemaVersion": { "const": 1 },
        "scannerObservations": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "observedAt", "sourceRunId"],
            "properties": {
              "source": { "enum": ["fresh", "snapshot"] },
              "observedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
              "sourceRunId": { "type": "string", "minLength": 1 },
              "snapshotDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "inputDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "allOf": [{
              "if": { "properties": { "source": { "const": "snapshot" } }, "required": ["source"] },
              "then": { "properties": { "snapshotDigest": true, "inputDigest": true }, "required": ["snapshotDigest", "inputDigest"] }
            }]
          }
        },
        "fixtureIndex": {
          "type": "object", "additionalProperties": false,
          "required": ["schemaVersion", "algorithm", "digest", "fixtureCount"],
          "properties": {
            "schemaVersion": { "const": 1 }, "algorithm": { "const": "sha256" },
            "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "fixtureCount": { "type": "integer", "minimum": 1 }
          }
        },
        "taxonomyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "publishedPackage": {
          "description": "Published mode only: the released package the pinned redact-secret entry loaded. Absent on a candidate run, which carries product instead.",
          "type": "object",
          "additionalProperties": false,
          "required": ["packageName", "version"],
          "properties": {
            "packageName": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }
          }
        },
        "product": {
          "description": "Present only when the evidence run measured a redact-secret candidate build (eval:classify with --candidate-*) instead of the published package; absent means the published package.",
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceCommit", "packageName", "declaredVersion", "artifacts"],
          "properties": {
            "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "packageName": { "type": "string" },
            "declaredVersion": { "type": "string" },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["role", "sha256"],
                "properties": { "role": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
              }
            }
          }
        }
      }
    },
    "providerCount": { "type": "integer", "minimum": 0 },
    "familyCount": { "type": "integer", "minimum": 0 },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable", "provisional", "pending", "unsupported"],
      "properties": {
        "stable": { "type": "integer", "minimum": 0 },
        "provisional": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 }
      }
    },
    "stableDistribution": {
      "type": "object", "additionalProperties": false, "required": ["documented", "empirical"],
      "properties": { "documented": { "type": "integer", "minimum": 0 }, "empirical": { "type": "integer", "minimum": 0 }, "policy-qualified": { "type": "integer", "minimum": 0 } }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "family", "familyName", "status", "evidenceTier", "evidenceBasis", "qualificationProfile", "providerSource", "corroboratingScanners", "twinCoverage", "unresolvedCriticalItems", "empiricalEvidence", "fixtureProfile", "detectors", "findingTypes", "reason", "profileCoverage"],
        "properties": {
          "provider": { "type": ["string", "null"] },
          "family": { "type": "string" },
          "familyName": { "type": "string" },
          "status": { "enum": ["stable", "provisional", "pending", "unsupported"] },
          "evidenceTier": { "enum": ["T0", "T1", "T2", "T3", null] },
          "evidenceBasis": { "enum": ["provider-documented", "corroborated", "empirically-observed", "project-policy", "none"] },
          "qualificationProfile": { "enum": ["documented", "empirical", "policy-qualified", null] },
          "providerSource": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["url", "observedAt", "formatVersion", "covers"],
            "properties": {
              "url": { "type": "string" },
              "observedAt": { "type": "string" },
              "formatVersion": { "type": "string" },
              "covers": { "type": "string" }
            }
          },
          "corroboratingScanners": { "type": "array", "items": { "type": "string" } },
          "twinCoverage": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["pairs", "failures", "unprobeable"],
            "properties": {
              "pairs": { "type": "integer", "minimum": 0 },
              "failures": { "type": "integer", "minimum": 0 },
              "unprobeable": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "required": ["reason", "observedAt"],
                "properties": {
                  "reason": { "type": "string", "minLength": 1 },
                  "observedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
                }
              }
            }
          },
          "unresolvedCriticalItems": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["metamorphic", "mutation", "differential"],
            "properties": {
              "metamorphic": { "type": "integer", "minimum": 0 },
              "mutation": { "type": "integer", "minimum": 0 },
              "differential": { "type": "integer", "minimum": 0 }
            }
          },
          "empiricalEvidence": {
            "type": ["object", "null"], "additionalProperties": false,
            "required": ["observations", "subjects", "issuanceDates", "corroborationReferences", "corroborationOwners", "corroborationClasses", "contradictions", "boundedContradictions", "uncertainty", "supportedContexts", "mode", "supportsBareValues"],
            "properties": {
              "observations": { "type": "integer", "minimum": 0 }, "subjects": { "type": "integer", "minimum": 0 },
              "issuanceDates": { "type": "integer", "minimum": 0 }, "corroborationClasses": { "type": "array", "items": { "type": "string" } },
              "corroborationReferences": { "type": "integer", "minimum": 0 }, "corroborationOwners": { "type": "integer", "minimum": 0 },
              "contradictions": { "type": "integer", "minimum": 0 }, "boundedContradictions": { "type": "integer", "minimum": 0 }, "uncertainty": { "type": ["string", "null"] },
              "supportedContexts": { "type": "array", "items": { "type": "string" } }, "mode": { "enum": ["shape", "context-constrained", null] },
              "supportsBareValues": { "type": "boolean" }
            }
          },
          "policyQualification": { "type": ["object", "null"] },
          "fixtureProfile": {
            "type": ["object", "null"], "additionalProperties": false,
            "required": ["positiveCases", "positiveAxes", "benignCases", "controlAxes", "twinPairs", "totalFixtures", "contextTwinPairs", "confusionAxes"],
            "properties": {
              "positiveCases": { "type": "integer", "minimum": 0 }, "positiveAxes": { "type": "integer", "minimum": 0 },
              "benignCases": { "type": "integer", "minimum": 0 }, "controlAxes": { "type": "integer", "minimum": 0 },
              "twinPairs": { "type": "integer", "minimum": 0 }, "totalFixtures": { "type": "integer", "minimum": 0 },
              "contextTwinPairs": { "type": "integer", "minimum": 0 }, "confusionAxes": { "type": "integer", "minimum": 0 }
            }
          },
          "detectors": { "type": "array", "items": { "type": "string" } },
          "findingTypes": {
            "description": "The (detector, finding type) pairs this row's evidence covers, so a shared detector joins to its rows per finding type. [] when the row has no detector; null (unset) when no recorded source grounds a key. Rule: docs/specs/support-matrix.md.",
            "type": ["array", "null"],
            "items": {
              "type": "object", "additionalProperties": false, "required": ["detector", "type", "basis"],
              "properties": {
                "detector": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "minLength": 1 },
                "basis": { "enum": ["sole-type-of-detector", "arrival-finding-type-table", "remaining-types-of-detector"] }
              }
            }
          },
          "reason": { "type": ["string", "null"] },
          "profileCoverage": { "oneOf": [{ "$ref": "#/definitions/fixtureProfile" }, { "type": "null" }] }
        }
      }
    },
    "findingTypeSource": {
      "description": "The product revision whose detector inventory the finding-type keys were read from.",
      "type": "object", "additionalProperties": false, "required": ["repository", "revision", "path", "sha256"],
      "properties": {
        "repository": { "const": "redact-secret/redact-secret" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "piiQualification": {
      "description": "Identity of the single qualification the piiFamilies statuses come from. The PII statuses are at that core commit and are not re-qualified on any later one.",
      "type": "object", "additionalProperties": false,
      "required": ["profile", "route", "binding", "maximumStatus", "qualifiedAt", "benchmarks", "record", "disposition", "commitments", "costAcceptance", "requalification"],
      "properties": {
        "profile": { "const": "pii-v1" },
        "route": { "type": "string", "minLength": 1 },
        "binding": { "type": "string", "minLength": 1 },
        "maximumStatus": { "const": "provisional" },
        "qualifiedAt": {
          "type": "object", "additionalProperties": false, "required": ["coreCommit", "epoch", "populationPlanSet"],
          "properties": {
            "coreCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "epoch": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
            "populationPlanSet": { "type": "string", "minLength": 1 }
          }
        },
        "benchmarks": {
          "type": "object", "additionalProperties": false, "required": ["recordRevision", "freezeBaseRevision"],
          "properties": {
            "recordRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "freezeBaseRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "record": { "type": "string", "minLength": 1 },
        "disposition": { "type": "string", "minLength": 1 },
        "commitments": {
          "type": "object", "additionalProperties": false, "required": ["freeze", "report", "disposition", "seal", "protectedDisposition"],
          "properties": {
            "freeze": { "$ref": "#/definitions/digest" }, "report": { "$ref": "#/definitions/digest" }, "disposition": { "$ref": "#/definitions/digest" },
            "seal": { "$ref": "#/definitions/digest" }, "protectedDisposition": { "$ref": "#/definitions/digest" }
          }
        },
        "costAcceptance": {
          "type": "object", "additionalProperties": false, "required": ["id", "entryCommitment", "status", "cells", "sizeRows"],
          "properties": {
            "id": { "type": "string", "minLength": 1 }, "entryCommitment": { "$ref": "#/definitions/digest" }, "status": { "const": "accepted" },
            "cells": { "type": "integer", "minimum": 0 }, "sizeRows": { "type": "integer", "minimum": 0 }
          }
        },
        "requalification": {
          "type": "object", "additionalProperties": false, "required": ["state", "requalifiedOnCoreCommit", "statement"],
          "properties": {
            "state": { "const": "not-requalified" },
            "requalifiedOnCoreCommit": { "type": "null" },
            "statement": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "piiDistribution": {
      "type": "object", "additionalProperties": false, "required": ["stable", "provisional", "pending", "unsupported"],
      "properties": {
        "stable": { "const": 0 }, "provisional": { "type": "integer", "minimum": 0 }, "pending": { "type": "integer", "minimum": 0 }, "unsupported": { "const": 0 }
      }
    },
    "piiFamilies": {
      "description": "The opt-in PII families, apart from the credential families: never counted in providerCount, familyCount, distribution or stableDistribution.",
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["family", "familyName", "status", "reason", "coverage", "findingTypes", "gates", "failedGates"],
        "properties": {
          "family": { "type": "string", "pattern": "^pii:[a-z0-9-]+:[a-z0-9-]+$" },
          "familyName": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "provisional"] },
          "reason": { "type": "string", "minLength": 1 },
          "coverage": {
            "type": "object", "additionalProperties": false, "required": ["scope", "jurisdiction", "restriction", "note"],
            "properties": {
              "scope": { "type": "string", "minLength": 1 }, "jurisdiction": { "type": ["string", "null"] },
              "restriction": { "type": ["string", "null"] }, "note": { "type": "string", "minLength": 1 }
            }
          },
          "findingTypes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^pii_[a-z0-9_]+$" } },
          "gates": {
            "type": "object", "additionalProperties": false, "required": ["public", "protected"],
            "properties": {
              "public": {
                "type": "object", "additionalProperties": false, "required": ["met", "notMet", "unresolved", "acceptedTradeoffs"],
                "properties": {
                  "met": { "type": "integer", "minimum": 0 },
                  "notMet": { "type": "array", "items": { "type": "string" } },
                  "unresolved": { "type": "array", "items": { "type": "string" } },
                  "acceptedTradeoffs": { "type": "array", "items": { "type": "string" } }
                }
              },
              "protected": {
                "type": "object", "additionalProperties": false, "required": ["state", "reason", "runs", "epochCommitment", "aggregateCommitment", "trustCommitment"],
                "properties": {
                  "state": { "enum": ["met", "not-met"] }, "reason": { "type": "string", "minLength": 1 }, "runs": { "type": "string", "pattern": "^[0-9]+/[0-9]+$" },
                  "epochCommitment": { "$ref": "#/definitions/digest" }, "aggregateCommitment": { "$ref": "#/definitions/digest" }, "trustCommitment": { "$ref": "#/definitions/digest" }
                }
              }
            }
          },
          "failedGates": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fixtureProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profilesVersion", "claimed", "explicit", "target", "cellsMet", "cells", "requiredCells", "requiredButEmptyAxisIds", "debt"],
      "properties": {
        "profilesVersion": { "type": "integer", "minimum": 1 },
        "claimed": { "enum": ["arrival-provisional", "stable-documented", "stable-empirical", "context-constrained-empirical", null] },
        "explicit": { "type": "boolean" },
        "target": { "enum": ["arrival-provisional", "stable-documented", "stable-empirical", "context-constrained-empirical"] },
        "cellsMet": { "type": "array", "items": { "enum": ["arrival-provisional", "stable-documented", "stable-empirical", "context-constrained-empirical"] } },
        "cells": {
          "type": "object",
          "additionalProperties": false,
          "required": ["totalFixtures", "positiveCases", "benignControls", "twinPairs", "positiveContextAxes", "controlAxes", "confusionAxes", "positiveContextAxisIds", "controlAxisIds", "confusionAxisIds"],
          "properties": {
            "totalFixtures": { "type": "integer", "minimum": 0 },
            "positiveCases": { "type": "integer", "minimum": 0 },
            "benignControls": { "type": "integer", "minimum": 0 },
            "twinPairs": { "type": "integer", "minimum": 0 },
            "positiveContextAxes": { "type": "integer", "minimum": 0 },
            "controlAxes": { "type": "integer", "minimum": 0 },
            "confusionAxes": { "type": "integer", "minimum": 0 },
            "positiveContextAxisIds": { "type": "array", "items": { "type": "string" } },
            "controlAxisIds": { "type": "array", "items": { "type": "string" } },
            "confusionAxisIds": { "type": "array", "items": { "type": "string" } }
          }
        },
        "requiredCells": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "totalFixtures": { "type": "integer", "minimum": 1 },
            "positiveCases": { "type": "integer", "minimum": 1 },
            "benignControls": { "type": "integer", "minimum": 1 },
            "twinPairs": { "type": "integer", "minimum": 1 },
            "positiveContextAxes": { "type": "integer", "minimum": 1 },
            "controlAxes": { "type": "integer", "minimum": 1 },
            "confusionAxes": { "type": "integer", "minimum": 1 }
          }
        },
        "requiredButEmptyAxisIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["positiveContextAxes", "controlAxes", "confusionAxes"] }
        },
        "debt": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cell", "actual", "required", "shortfall"],
            "properties": {
              "cell": { "enum": ["totalFixtures", "positiveCases", "benignControls", "twinPairs", "positiveContextAxes", "controlAxes", "confusionAxes"] },
              "actual": { "type": "integer", "minimum": 0 },
              "required": { "type": "integer", "minimum": 1 },
              "shortfall": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
