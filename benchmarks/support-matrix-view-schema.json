{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:redact-secret-benchmarks:support-matrix-from-view:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "publication",
    "source",
    "providerCount",
    "familyCount",
    "distribution",
    "stableDistribution",
    "families",
    "findingTypeSource"
  ],
  "properties": {
    "schema": {
      "const": "redact-secret/support-matrix-from-view/v1"
    },
    "mode": {
      "enum": [
        "published",
        "candidate-projection"
      ]
    },
    "publication": {
      "enum": [
        "public",
        "internal"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view",
        "populations"
      ],
      "properties": {
        "view": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "adapter",
            "policyRevision"
          ],
          "properties": {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "adapter": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "policyRevision": {
              "type": "string",
              "pattern": "^rs-policy-[0-9]+:sha256:[a-f0-9]{64}$"
            }
          }
        },
        "populations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "population",
              "runClass",
              "semanticDigest",
              "artifactDigest",
              "engineVersion",
              "scannerBuilds",
              "scannerVersions"
            ],
            "properties": {
              "population": {
                "type": "string",
                "minLength": 1
              },
              "runClass": {
                "enum": [
                  "public",
                  "internal"
                ]
              },
              "semanticDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "artifactDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "engineVersion": {
                "type": "string",
                "minLength": 1
              },
              "scannerBuilds": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "scannerVersions": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "publishedPackage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packageName",
            "version"
          ],
          "properties": {
            "packageName": {
              "const": "@redact-secret/core"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "providerCount": {
      "type": "integer",
      "minimum": 0
    },
    "familyCount": {
      "type": "integer",
      "minimum": 0
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable",
        "provisional",
        "pending",
        "unsupported"
      ],
      "properties": {
        "stable": {
          "type": "integer",
          "minimum": 0
        },
        "provisional": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "stableDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documented",
        "empirical"
      ],
      "properties": {
        "documented": {
          "type": "integer",
          "minimum": 0
        },
        "empirical": {
          "type": "integer",
          "minimum": 0
        },
        "policy-qualified": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "family",
          "familyName",
          "status",
          "evidenceTier",
          "evidenceBasis",
          "qualificationProfile",
          "providerSource",
          "corroboratingScanners",
          "twinCoverage",
          "unresolvedCriticalItems",
          "empiricalEvidence",
          "fixtureProfile",
          "detectors",
          "findingTypes",
          "reason",
          "profileCoverage"
        ],
        "properties": {
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "family": {
            "type": "string"
          },
          "familyName": {
            "type": "string"
          },
          "status": {
            "enum": [
              "stable",
              "provisional",
              "pending",
              "unsupported"
            ]
          },
          "evidenceTier": {
            "enum": [
              "T0",
              "T1",
              "T2",
              "T3",
              null
            ]
          },
          "evidenceBasis": {
            "enum": [
              "provider-documented",
              "corroborated",
              "empirically-observed",
              "project-policy",
              "none"
            ]
          },
          "qualificationProfile": {
            "enum": [
              "documented",
              "empirical",
              "policy-qualified",
              null
            ]
          },
          "providerSource": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "url",
              "observedAt",
              "formatVersion",
              "covers"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "observedAt": {
                "type": "string"
              },
              "formatVersion": {
                "type": "string"
              },
              "covers": {
                "type": "string"
              }
            }
          },
          "corroboratingScanners": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "twinCoverage": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "pairs",
              "failures",
              "unprobeable"
            ],
            "properties": {
              "pairs": {
                "type": "integer",
                "minimum": 0
              },
              "failures": {
                "type": "integer",
                "minimum": 0
              },
              "unprobeable": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "reason",
                  "observedAt"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "observedAt": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                }
              }
            }
          },
          "unresolvedCriticalItems": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "metamorphic",
              "mutation",
              "differential"
            ],
            "properties": {
              "metamorphic": {
                "type": "integer",
                "minimum": 0
              },
              "mutation": {
                "type": "integer",
                "minimum": 0
              },
              "differential": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "empiricalEvidence": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "observations",
              "subjects",
              "issuanceDates",
              "corroborationReferences",
              "corroborationOwners",
              "corroborationClasses",
              "contradictions",
              "boundedContradictions",
              "uncertainty",
              "supportedContexts",
              "mode",
              "supportsBareValues"
            ],
            "properties": {
              "observations": {
                "type": "integer",
                "minimum": 0
              },
              "subjects": {
                "type": "integer",
                "minimum": 0
              },
              "issuanceDates": {
                "type": "integer",
                "minimum": 0
              },
              "corroborationClasses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "corroborationReferences": {
                "type": "integer",
                "minimum": 0
              },
              "corroborationOwners": {
                "type": "integer",
                "minimum": 0
              },
              "contradictions": {
                "type": "integer",
                "minimum": 0
              },
              "boundedContradictions": {
                "type": "integer",
                "minimum": 0
              },
              "uncertainty": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "supportedContexts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "mode": {
                "enum": [
                  "shape",
                  "context-constrained",
                  null
                ]
              },
              "supportsBareValues": {
                "type": "boolean"
              }
            }
          },
          "policyQualification": {
            "type": [
              "object",
              "null"
            ]
          },
          "fixtureProfile": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "positiveCases",
              "positiveAxes",
              "benignCases",
              "controlAxes",
              "twinPairs",
              "totalFixtures",
              "contextTwinPairs",
              "confusionAxes"
            ],
            "properties": {
              "positiveCases": {
                "type": "integer",
                "minimum": 0
              },
              "positiveAxes": {
                "type": "integer",
                "minimum": 0
              },
              "benignCases": {
                "type": "integer",
                "minimum": 0
              },
              "controlAxes": {
                "type": "integer",
                "minimum": 0
              },
              "twinPairs": {
                "type": "integer",
                "minimum": 0
              },
              "totalFixtures": {
                "type": "integer",
                "minimum": 0
              },
              "contextTwinPairs": {
                "type": "integer",
                "minimum": 0
              },
              "confusionAxes": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "detectors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "findingTypes": {
            "description": "The (detector, finding type) pairs this row's evidence covers, so a shared detector joins to its rows per finding type. [] when the row has no detector; null (unset) when no recorded source grounds a key. Rule: docs/specs/support-matrix.md.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "detector",
                "type",
                "basis"
              ],
              "properties": {
                "detector": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "basis": {
                  "enum": [
                    "sole-type-of-detector",
                    "arrival-finding-type-table",
                    "remaining-types-of-detector"
                  ]
                }
              }
            }
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "profileCoverage": {
            "oneOf": [
              {
                "$ref": "#/definitions/fixtureProfile"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "findingTypeSource": {
      "description": "The product revision whose detector inventory the finding-type keys were read from.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "path",
        "sha256"
      ],
      "properties": {
        "repository": {
          "const": "redact-secret/redact-secret"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "piiCurrentQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "state",
        "sourceCommit",
        "supportClaims",
        "qualified",
        "evidenceScope",
        "publicMeasurement",
        "gates",
        "distribution",
        "families"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "state": {
          "enum": [
            "prepared",
            "recorded",
            "invalid"
          ]
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "supportClaims": {
          "const": false
        },
        "qualified": {
          "const": false
        },
        "evidenceScope": {
          "const": "public-synthetic-only"
        },
        "publicMeasurement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "mode",
            "reason",
            "receiptDigest",
            "productArtifactDigest",
            "baselineSourceCommit",
            "engineBinaryDigest"
          ],
          "properties": {
            "state": {
              "enum": [
                "not-recorded",
                "recorded",
                "invalid"
              ]
            },
            "mode": {
              "enum": [
                "exploratory",
                "official",
                null
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "receiptDigest": {
              "anyOf": [
                {
                  "$ref": "#/definitions/digest"
                },
                {
                  "type": "null"
                }
              ]
            },
            "productArtifactDigest": {
              "anyOf": [
                {
                  "$ref": "#/definitions/digest"
                },
                {
                  "type": "null"
                }
              ]
            },
            "baselineSourceCommit": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "engineBinaryDigest": {
              "anyOf": [
                {
                  "$ref": "#/definitions/digest"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "recorded"
                  }
                }
              },
              "then": {
                "properties": {
                  "mode": {
                    "enum": [
                      "exploratory",
                      "official"
                    ]
                  },
                  "reason": {
                    "type": "null"
                  },
                  "receiptDigest": {
                    "$ref": "#/definitions/digest"
                  },
                  "productArtifactDigest": {
                    "$ref": "#/definitions/digest"
                  },
                  "baselineSourceCommit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  },
                  "engineBinaryDigest": {
                    "$ref": "#/definitions/digest"
                  }
                }
              },
              "else": {
                "properties": {
                  "mode": {
                    "type": "null"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "receiptDigest": {
                    "type": "null"
                  },
                  "productArtifactDigest": {
                    "type": "null"
                  },
                  "baselineSourceCommit": {
                    "type": "null"
                  },
                  "engineBinaryDigest": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publicQualification",
            "validator",
            "runtimeAndPackageCost",
            "sizeRegressionBudget",
            "profileCost",
            "protectedPath",
            "protectedPartition"
          ],
          "properties": {
            "publicQualification": {
              "const": "not-evaluated"
            },
            "validator": {
              "const": "not-measured"
            },
            "runtimeAndPackageCost": {
              "const": "unmeasured"
            },
            "sizeRegressionBudget": {
              "const": "unmeasured"
            },
            "profileCost": {
              "const": "unmeasured"
            },
            "protectedPath": {
              "const": "pending-not-operational"
            },
            "protectedPartition": {
              "const": "not-run"
            }
          }
        },
        "distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stable",
            "provisional",
            "pending",
            "unsupported"
          ],
          "properties": {
            "stable": {
              "const": 0
            },
            "provisional": {
              "const": 0
            },
            "pending": {
              "type": "integer",
              "minimum": 1
            },
            "unsupported": {
              "const": 0
            }
          }
        },
        "families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "family",
              "status",
              "reasonCodes"
            ],
            "properties": {
              "family": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "const": "pending"
              },
              "reasonCodes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "description": "Exact current target and separate public measurement; never relabels historical piiFamilies or qualifies protected support."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "published"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "publication": {
            "const": "public"
          },
          "source": {
            "required": [
              "publishedPackage"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "publication": {
            "const": "internal"
          }
        }
      }
    }
  ],
  "definitions": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fixtureProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profilesVersion",
        "claimed",
        "explicit",
        "target",
        "cellsMet",
        "cells",
        "requiredCells",
        "requiredButEmptyAxisIds",
        "debt"
      ],
      "properties": {
        "profilesVersion": {
          "type": "integer",
          "minimum": 1
        },
        "claimed": {
          "enum": [
            "arrival-provisional",
            "stable-documented",
            "stable-empirical",
            "context-constrained-empirical",
            null
          ]
        },
        "explicit": {
          "type": "boolean"
        },
        "target": {
          "enum": [
            "arrival-provisional",
            "stable-documented",
            "stable-empirical",
            "context-constrained-empirical"
          ]
        },
        "cellsMet": {
          "type": "array",
          "items": {
            "enum": [
              "arrival-provisional",
              "stable-documented",
              "stable-empirical",
              "context-constrained-empirical"
            ]
          }
        },
        "cells": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "totalFixtures",
            "positiveCases",
            "benignControls",
            "twinPairs",
            "positiveContextAxes",
            "controlAxes",
            "confusionAxes",
            "positiveContextAxisIds",
            "controlAxisIds",
            "confusionAxisIds"
          ],
          "properties": {
            "totalFixtures": {
              "type": "integer",
              "minimum": 0
            },
            "positiveCases": {
              "type": "integer",
              "minimum": 0
            },
            "benignControls": {
              "type": "integer",
              "minimum": 0
            },
            "twinPairs": {
              "type": "integer",
              "minimum": 0
            },
            "positiveContextAxes": {
              "type": "integer",
              "minimum": 0
            },
            "controlAxes": {
              "type": "integer",
              "minimum": 0
            },
            "confusionAxes": {
              "type": "integer",
              "minimum": 0
            },
            "positiveContextAxisIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "controlAxisIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "confusionAxisIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "requiredCells": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "totalFixtures": {
              "type": "integer",
              "minimum": 1
            },
            "positiveCases": {
              "type": "integer",
              "minimum": 1
            },
            "benignControls": {
              "type": "integer",
              "minimum": 1
            },
            "twinPairs": {
              "type": "integer",
              "minimum": 1
            },
            "positiveContextAxes": {
              "type": "integer",
              "minimum": 1
            },
            "controlAxes": {
              "type": "integer",
              "minimum": 1
            },
            "confusionAxes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "requiredButEmptyAxisIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "positiveContextAxes",
              "controlAxes",
              "confusionAxes"
            ]
          }
        },
        "debt": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cell",
              "actual",
              "required",
              "shortfall"
            ],
            "properties": {
              "cell": {
                "enum": [
                  "totalFixtures",
                  "positiveCases",
                  "benignControls",
                  "twinPairs",
                  "positiveContextAxes",
                  "controlAxes",
                  "confusionAxes"
                ]
              },
              "actual": {
                "type": "integer",
                "minimum": 0
              },
              "required": {
                "type": "integer",
                "minimum": 1
              },
              "shortfall": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
