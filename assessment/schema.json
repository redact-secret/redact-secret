{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/redact-secret/redact-secret/assessment/schema.json",
  "title": "Cross-language evaluation protocol schema",
  "description": "Language-neutral schema for decision-define-cross-language-evaluation-protocol: the synthetic assessment corpus, its workload profiles, and the common result contract. Expected ranges (`fixtures[].expected[].start`/`end`) are UTF-8 byte offsets, on the same terms as conformance/schema.json. Structural constraints this document cannot express (no overlapping expectations, ranges within input bounds, accuracy/scale profile size and chunking rules, at-least-one-metrics-kind) are enforced by the accompanying validator (assessment/schema.ts) and MUST be checked in addition to this schema.",
  "oneOf": [
    { "$ref": "#/$defs/accuracyCorpusDocument" },
    { "$ref": "#/$defs/workloadProfileDocument" },
    { "$ref": "#/$defs/resultContractDocument" }
  ],
  "$defs": {
    "caseId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$"
    },
    "category": {
      "enum": ["logs", "code", "chat", "negative-text"]
    },
    "confidence": {
      "enum": ["high", "medium", "low"]
    },
    "specificity": {
      "enum": ["private-key", "provider", "structural", "contextual", "entropy"]
    },
    "policyOutcome": {
      "enum": ["block", "redact", "warn", "allow"]
    },
    "surface": {
      "enum": ["rust-core", "python", "node", "browser-wasm", "cli"]
    },
    "chunkProfile": {
      "enum": ["whole", "fixed-1024", "fixed-4096", "fixed-65536", "utf16-boundary"]
    },
    "expectation": {
      "type": "object",
      "description": "Deliberately closed: no field here may carry matched plaintext.",
      "additionalProperties": false,
      "required": [
        "detector", "type", "confidence", "specificity", "start", "end",
        "policyOutcome"
      ],
      "properties": {
        "detector": { "$ref": "#/$defs/identifier" },
        "type": { "$ref": "#/$defs/identifier" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "specificity": { "$ref": "#/$defs/specificity" },
        "start": {
          "type": "integer",
          "minimum": 0,
          "description": "UTF-8 byte offset, inclusive."
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "description": "UTF-8 byte offset, exclusive."
        },
        "policyOutcome": { "$ref": "#/$defs/policyOutcome" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "unicode", "input", "expected", "note"],
      "properties": {
        "id": { "$ref": "#/$defs/caseId" },
        "category": { "$ref": "#/$defs/category" },
        "unicode": { "type": "boolean" },
        "input": {
          "type": "string",
          "description": "Synthetic input only. Never an active or reported credential."
        },
        "expected": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectation" }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "accuracyCorpusDocument": {
      "type": "object",
      "required": ["offsetUnit", "fixtureCount", "fixtures"],
      "additionalProperties": false,
      "properties": {
        "offsetUnit": { "const": "utf8-byte" },
        "fixtureCount": { "type": "integer", "minimum": 0 },
        "fixtures": {
          "type": "array",
          "items": { "$ref": "#/$defs/fixture" }
        }
      }
    },
    "workloadProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "purpose", "category", "targetInputBytes",
        "targetDensityPerKiB", "chunkProfile", "unicodeMix",
        "generatorAlgorithm", "note"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/caseId" },
        "purpose": { "enum": ["accuracy", "scale"] },
        "category": { "$ref": "#/$defs/category" },
        "targetInputBytes": { "type": "integer", "exclusiveMinimum": 0 },
        "targetDensityPerKiB": { "type": "number", "minimum": 0 },
        "chunkProfile": { "$ref": "#/$defs/chunkProfile" },
        "unicodeMix": { "type": "boolean" },
        "generatorAlgorithm": { "$ref": "#/$defs/identifier" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "workloadProfileDocument": {
      "type": "object",
      "required": ["profileCount", "profiles"],
      "additionalProperties": false,
      "properties": {
        "profileCount": { "type": "integer", "minimum": 0 },
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/workloadProfile" }
        }
      }
    },
    "accuracyMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truePositives", "falsePositives", "falseNegatives", "policyMismatches"
      ],
      "properties": {
        "truePositives": { "type": "integer", "minimum": 0 },
        "falsePositives": { "type": "integer", "minimum": 0 },
        "falseNegatives": { "type": "integer", "minimum": 0 },
        "policyMismatches": { "type": "integer", "minimum": 0 }
      }
    },
    "performanceMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialization", "processing", "throughput", "memory"],
      "properties": {
        "initialization": { "$ref": "#/$defs/measurementDistribution" },
        "processing": { "$ref": "#/$defs/measurementDistribution" },
        "throughput": { "$ref": "#/$defs/measurementDistribution" },
        "memory": { "$ref": "#/$defs/memoryMetrics" }
      }
    },
    "measurementDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit", "samples", "minimum", "median", "p95", "maximum", "mean",
        "standardDeviation"
      ],
      "properties": {
        "unit": { "enum": ["milliseconds", "bytes-per-second"] },
        "samples": {
          "type": "array", "minItems": 1,
          "items": { "type": "number", "minimum": 0 }
        },
        "minimum": { "type": "number", "minimum": 0 },
        "median": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "maximum": { "type": "number", "minimum": 0 },
        "mean": { "type": "number", "minimum": 0 },
        "standardDeviation": { "type": "number", "minimum": 0 }
      }
    },
    "memorySample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineBytes", "maximumObservedBytes"],
      "properties": {
        "baselineBytes": { "type": "integer", "minimum": 0 },
        "maximumObservedBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "memoryMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "samples", "samplingLimit"],
      "properties": {
        "unit": { "const": "bytes" },
        "samples": { "type": "array", "items": { "$ref": "#/$defs/memorySample" } },
        "unavailableReason": { "type": "string", "minLength": 1 },
        "samplingLimit": { "type": "string", "minLength": 1 }
      }
    },
    "memoryMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeHeap", "nodeRss", "nodeExternal", "browserJsHeap", "wasmLinearMemory",
        "pythonHeap", "processRss", "streamingBuffer"
      ],
      "properties": {
        "nodeHeap": { "$ref": "#/$defs/memoryMetric" },
        "nodeRss": { "$ref": "#/$defs/memoryMetric" },
        "nodeExternal": { "$ref": "#/$defs/memoryMetric" },
        "browserJsHeap": { "$ref": "#/$defs/memoryMetric" },
        "wasmLinearMemory": { "$ref": "#/$defs/memoryMetric" },
        "pythonHeap": { "$ref": "#/$defs/memoryMetric" },
        "processRss": { "$ref": "#/$defs/memoryMetric" },
        "streamingBuffer": { "$ref": "#/$defs/memoryMetric" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit", "artifactIdentity", "corpusVersion", "corpusHash", "os",
        "cpu", "runtime", "command"
      ],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifactIdentity": { "type": "string", "minLength": 1 },
        "corpusVersion": { "type": "string", "minLength": 1 },
        "corpusHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "os": { "type": "string", "minLength": 1 },
        "cpu": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "buildProfile": { "enum": ["debug", "release"] },
        "resolvedArtifact": { "enum": ["node-addon", "wasm"] }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "surface", "profileId", "provenance"],
      "anyOf": [
        { "required": ["accuracy"] },
        { "required": ["performance"] }
      ],
      "properties": {
        "schemaVersion": { "const": "3" },
        "surface": { "$ref": "#/$defs/surface" },
        "profileId": { "$ref": "#/$defs/caseId" },
        "accuracy": { "$ref": "#/$defs/accuracyMetrics" },
        "performance": { "$ref": "#/$defs/performanceMetrics" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "resultContractDocument": {
      "type": "object",
      "required": ["resultCount", "results"],
      "additionalProperties": false,
      "properties": {
        "resultCount": { "type": "integer", "minimum": 0 },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/result" }
        }
      }
    }
  }
}
