{
  "name": "@redact-secret/node",
  "version": "0.1.0-beta.6",
  "private": true,
  "description": "N-API native addon for @redact-secret/core. Built with @napi-rs/cli; not published on its own.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redact-secret/redact-secret.git",
    "directory": "bindings/node"
  },
  "napi": {
    "binaryName": "redact-secret",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ]
  },
  "engines": {
    "node": "20.x || 22.x || 24.x"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "smoke": "node smoke-test.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.9.0"
  }
}
