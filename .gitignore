# macOS Finder metadata, at any directory depth
.DS_Store

/_notes/
/.agents/skills/context-governance/
/dist/
/node_modules/

# Built output of the unified npm package (regenerate with
# `npm run js:build`); only the tarball's `dist` is published.
/packages/javascript/dist/
/packages/javascript/node_modules/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
/benchmark-evidence/

# Scratch output of the assessment runners (npm run assessment:all, etc.);
# performance results, criteria, and baselines live in
# redact-secret-benchmarks instead (issue #603).
/assessment-output/
/assessment-output-*/

# Rust build output
/target/

# OpenGrep's verified binary cache (scripts/install-opengrep.py); re-verified
# from sast/opengrep.lock.json on every install, never committed. CI's
# per-run report is regenerated by scripts/run-sast.py each run -- only the
# reviewed baseline snapshot under sast/reports/ is committed by hand.
/.cache/opengrep/
# Publish-shaped redact-secret-adapters tarballs built from the commit pinned
# in adapters/pin-source.json (scripts/adapter-pins.py), re-verified against
# its content digests on every install, never committed; and the example
# project they are installed into.
/.cache/adapters/
/examples/mcp-redact/node_modules/
# The reference architectures' registry installs (`npm run references:smoke`).
/examples/logging-redaction/node_modules/
/examples/tracing-masking/node_modules/
/examples/ai-context/node_modules/
/sast/reports/ci-latest.json

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# maturin builds the native extension in place for `maturin develop`
/bindings/python/python/redact_secret/_native*.so
/bindings/python/python/redact_secret/_native*.pyd

# Generated N-API build output (regenerate with `npm ci && npm run build`
# in bindings/node); the compiled addon is platform-specific and the
# JS/TypeScript glue is regenerated from src/lib.rs by napi-rs. The lockfile
# is tracked: the qualification matrix installs the build toolchain with
# `npm ci`, which needs one.
/bindings/node/node_modules/
/bindings/node/index.js
/bindings/node/index.d.ts
/bindings/node/*.node

# Generated browser WebAssembly artifact (regenerate with
# `npm run wasm:build`); the glue and the `.wasm` binary are build output.
/bindings/wasm/pkg/
/bindings/wasm/pkg-common/

# Each npm/<platform> directory under bindings/node ships one published
# package.json plus a compiled addon copied in at publish/qualification time
# (issue #79); only the manifest is tracked.
/bindings/node/npm/*/*.node

# bindings/wasm/npm ships one published package.json plus the
# `wasm-bindgen --target web` output copied in at publish/qualification time
# (issue #79); only the manifest is tracked.
/bindings/wasm/npm/*.js
/bindings/wasm/npm/*.wasm
/bindings/wasm/npm/*.d.ts
