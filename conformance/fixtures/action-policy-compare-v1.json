  "hostObligations": [
    {
      "id": "preview-is-not-enforcement",
      "statement": "A comparison never edits the input and returns no sanitized text and no placeholder. The same input scanned and redacted before and after a comparison yields byte-identical output."
    },
    {
      "id": "detection-runs-once",
      "statement": "Detection runs once per comparison regardless of the number of sides; a policy cannot change which findings exist."
    },
    {
      "id": "finalized-findings-only",
      "statement": "The result lists exactly the findings `scan` returns for the same input and detection configuration, in the same order and with the same ids, ranges and metadata."
    },
    {
      "id": "no-plaintext",
      "statement": "The result carries no input byte, matched value, snippet, hash of either, or score. A policy document's digest is the only digest."
    },
    {
