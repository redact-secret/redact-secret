{
  "$schema": "action-policy-compare-v1",
  "schemaVersion": 1,
  "contract": "decision-explain-and-compare-action-policies-over-one-detection-pass",
  "description": "The shared conformance fixture for the explain-and-compare primitive (issue #1220). It is data only. A surface that exposes the primitive runs every `case`, `error` and `digest` through its public API and asserts the per-finding actions, bases, rule ids and indexes, the `differs` flag, the per-side counts and the callback call sequence. The Rust core runs it for semantics and the Rust CLI for plumbing. `base` is a sentinel, never a literal action: a runner resolves it by asking its own surface's default evaluation of the same input with no policy (`scan` with the default policy), so this file copies no part of the default table. A runner also asserts, for every `policy` side, that each finding's action equals the action `scan` with that same document yields for that finding (enforcement parity), and that the serialized result contains no byte of the input. Offsets are UTF-8 bytes in the original input; a UTF-16 or code-point surface converts them. Every input and document is synthetic.",
  "revision": 1,
  "baseSentinel": "base",
  "ruleset": "ruleset-revision: 1\ndetector: acme-alnum-token\nspecificity: contextual\nprefix: \"ACME_AN_\"\nalphabet: alnum\nrun: at-least 20\nvalidator: none\n",
  "limits": {
    "maxPolicies": 4,
    "defaultMaxFindings": 50000,
    "defaultMaxInputBytes": 67108864
  },
  "basisNames": [
    "rule",
    "rule-default",
    "no-rule-matched",
    "default-policy",
    "callback"
  ],
  "sideKinds": [
    "default",
    "policy",
    "callback"
  ],
  "policies": [
    {
      "id": "empty-rules",
      "documentText": "{\"actionPolicyRevision\":1,\"base\":\"default\",\"rules\":[]}"
    },
    {
      "id": "empty-rules-spaced",
      "documentText": "{\n  \"actionPolicyRevision\": 1,\n  \"base\": \"default\",\n  \"rules\": []\n}"
    },
    {
      "id": "four-actions",
      "documentText": "{\"actionPolicyRevision\":1,\"base\":\"default\",\"rules\":[{\"id\":\"redact-acme\",\"match\":{\"type\":[\"acme-alnum-token\"]},\"action\":\"redact\"},{\"id\":\"allow-github\",\"match\":{\"type\":[\"github_token\"]},\"action\":\"allow\"},{\"id\":\"warn-private-key\",\"match\":{\"type\":[\"private_key\"]},\"action\":\"warn\"}]}"
    },
    {
      "id": "block-high",
      "documentText": "{\"actionPolicyRevision\":1,\"base\":\"default\",\"rules\":[{\"id\":\"block-high\",\"match\":{\"confidence\":[\"high\"]},\"action\":\"block\"}]}"
    },
    {
      "id": "default-carve-out",
      "documentText": "{\"actionPolicyRevision\":1,\"base\":\"default\",\"rules\":[{\"id\":\"keep-default-github\",\"match\":{\"type\":[\"github_token\"]},\"action\":\"default\"},{\"id\":\"allow-high\",\"match\":{\"confidence\":[\"high\"]},\"action\":\"allow\"}]}"
    },
    {
      "id": "explicit-redact-github",
      "documentText": "{\"actionPolicyRevision\":1,\"base\":\"default\",\"rules\":[{\"id\":\"redact-github\",\"match\":{\"type\":[\"github_token\"]},\"action\":\"redact\"}]}"
    },
    {
      "id": "allow-bearer",
      "documentText": "{\"actionPolicyRevision\":1,\"base\":\"default\",\"rules\":[{\"id\":\"allow-bearer\",\"match\":{\"type\":[\"bearer_token\"]},\"action\":\"allow\"}]}"
    },
    {
      "id": "block-obfuscated-github",
      "documentText": "{\"actionPolicyRevision\":1,\"base\":\"default\",\"rules\":[{\"id\":\"block-obfuscated-github\",\"match\":{\"type\":[\"github_token\"],\"obfuscation\":[\"invisible-characters\"]},\"action\":\"block\"}]}"
    }
  ],
  "digests": [
