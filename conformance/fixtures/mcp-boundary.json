{
  "schemaVersion": 1,
  "contract": "docs/reference/mcp-boundary.md",
  "baseContract": "docs/reference/ai-context-boundary.md",
  "note": "Supported MCP redaction boundary cases (issue #612), a thin specialization of the AI-context boundary fixture (#610). Every value is synthetic: the ghp_SYNTHETICREVOKED token and the private-key body come from synchronous-corpus.json via ai-context-boundary.json; synthetic-not-a-secret is detected only by its key context. All inputs are ASCII. Runner: conformance/mcp-boundary.mjs.",
  "limits": {
    "wholeInput": {
      "maxInputBytes": 4096,
      "maxFindings": 16
    },
    "incremental": {
      "maxInputBytes": 4096,
      "maxBufferedBytes": 2176,
      "maxTokenBytes": 1024,
      "maxMultilineBytes": 2048
    },
    "traversal": {
      "maxDepth": 6,
      "maxNodes": 64
    }
  },
  "safeFindingFields": [
    "id",
    "type",
    "detector",
    "confidence",
    "action",
    "obfuscation",
    "start",
    "end"
  ],
  "contentTypes": [
    "text",
    "image",
    "audio",
    "resource_link",
    "resource"
  ],
  "fixedResults": {
    "blocked": {
      "content": [
        {
          "type": "text",
          "text": "This MCP tool call was blocked by secret-redaction policy. No content, arguments, or error detail is included."
        }
      ],
      "isError": true
    },
    "toolError": {
      "content": [
        {
          "type": "text",
          "text": "This MCP tool call failed. No content, arguments, or error detail is included."
        }
      ],
      "isError": true
    }
  },
