        "mode": "all-included",
        "disabledCount": 0,
        "inert": false,
        "policySource": "default",
        "limits": {
          "maxInputBytes": 67108864,
          "maxFindings": 50000
        },
        "origins": {
          "detection": "artifact-default",
          "pii": "artifact-default",
          "ruleset": "artifact-default",
          "actionPolicy": "artifact-default",
          "maxInputBytes": "artifact-default",
          "maxFindings": "artifact-default"
        }
      }
    },
