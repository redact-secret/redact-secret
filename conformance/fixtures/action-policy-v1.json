  "endToEnd": {
    "description": "End-to-end cases through each surface's public scan API. A surface that cannot construct a finding without scanning runs these instead of, or in addition to, `evaluations`. `base` resolves to the action the same input yields with no policy at all. Offsets are UTF-8 bytes in the original input; a UTF-16 or code-point surface converts them. Findings are listed in input order.",
    "ruleset": "ruleset-revision: 1\ndetector: acme-alnum-token\nspecificity: contextual\nprefix: \"ACME_AN_\"\nalphabet: alnum\nrun: at-least 20\nvalidator: none\n",
    "cases": [
      {
        "id": "overlap-loser-is-never-an-input",
        "policy": {
          "actionPolicyRevision": 1,
          "base": "default",
          "rules": [
            {
              "id": "allow-bearer",
              "match": {
                "type": [
                  "bearer_token"
                ]
              },
              "action": "allow"
            }
          ]
        },
        "input": "twilio Authorization: \u0042earer fedcba9876543210fedcba9876543210",
        "expectedFindings": [
          {
            "type": "bearer_token",
            "detector": "bearer-token",
            "confidence": "high",
            "obfuscation": "none",
            "start": 29,
            "end": 61,
            "expectedAction": "allow",
            "expectedRule": "allow-bearer"
          }
        ],
        "alsoIncremental": true,
        "note": "Overlap resolution ranks by the fixed default and picks bearer_token over the lower twilio_auth_token candidate before any policy runs. Allowing the winner leaves the text unchanged and does not resurrect the loser (decision-resolve-overlap-precedence-by-resolved-action-severity)."
      },
      {
        "id": "unmatched-falls-back-to-base",
        "policy": "names-not-yet-emitted",
        "input": "API_KEY=ghp_SYNTHETICREVOKED00000000000000000000",
        "expectedFindings": [
          {
            "type": "github_token",
            "detector": "github-token",
            "confidence": "high",
            "obfuscation": "none",
            "start": 8,
            "end": 48,
            "expectedAction": "base",
            "expectedRule": null
          }
        ],
        "alsoIncremental": true
      },
      {
        "id": "obfuscated-finding-blocks",
        "policy": "type-and-obfuscation",
        "input": "API_KEY=ghp_SYNTHE\u200bTICREVOKED00000000000000000000",
        "expectedFindings": [
          {
            "type": "github_token",
            "detector": "github-token",
            "confidence": "high",
            "obfuscation": "invisible-characters",
            "start": 8,
            "end": 51,
            "expectedAction": "block",
            "expectedRule": "block-obfuscated-github"
          }
        ],
        "alsoIncremental": true,
        "note": "The input holds one U+200B inside the credential; the range is in original-input coordinates."
      },
      {
        "id": "ruleset-type-upgraded-to-redact",
        "policy": "all-four-actions",
        "useRuleset": true,
        "input": "ACME_AN_aB1cD2eF3gH4iJ5kL6mN",
        "expectedFindings": [
          {
            "type": "acme-alnum-token",
            "detector": "acme-alnum-token",
            "confidence": "medium",
            "obfuscation": "none",
            "start": 0,
            "end": 28,
            "expectedAction": "redact",
            "expectedRule": "redact-ruleset-type"
          }
        ],
        "alsoIncremental": false,
        "note": "Incremental sessions accept no ruleset on any surface, so this case is whole-input only."
      },
      {
        "id": "private-key-default-blocks",
        "policy": "empty-rules",
        "input": "\u002d----BEGIN PRIVATE KEY-----\nU1lOVEhFVElDX1JFVk9LRURfRklYVFVSRQ==\n\u002d----END PRIVATE KEY-----\n",
        "expectedFindings": [
          {
            "type": "private_key",
            "detector": "private-key",
            "confidence": "high",
            "obfuscation": "none",
            "start": 0,
            "end": 90,
            "expectedAction": "base",
            "expectedRule": null
          }
        ],
        "alsoIncremental": true
      }
    ]
  },
  "hostObligations": [
    {
      "id": "legacy-callback-replaces-the-default",
      "statement": "A policy callback still replaces the default entirely: its return value is the action, with no overlay or base consulted.",
      "expectedCode": null
    },
    {
      "id": "legacy-callback-throws",
      "statement": "A callback that throws fails the whole call with the existing fixed code.",
      "expectedCode": "POLICY_FAILURE"
    },
    {
      "id": "legacy-callback-invalid-action",
      "statement": "A callback that returns anything but redact, block, warn or allow fails the whole call with the existing fixed code.",
      "expectedCode": "INVALID_POLICY_ACTION"
    },
    {
      "id": "callback-and-action-policy-together",
      "statement": "Supplying both a callback policy and an action policy to one call or session is rejected before any scan.",
      "expectedCode": "INVALID_OPTIONS"
    },
    {
      "id": "invalid-document-fails-before-scanning",
      "statement": "A rejected document fails construction or the call with the fixed code, never a partial load and never the default.",
      "expectedCode": "INVALID_ACTION_POLICY"
    },
    {
      "id": "session-binds-policy-at-construction",
      "statement": "An incremental session evaluates the policy it was constructed with; building another policy afterwards changes nothing about it.",
      "expectedCode": null
    },
    {
      "id": "no-process-global-policy-slot",
      "statement": "Two live policies of different content on one surface evaluate independently, in either construction order.",
      "expectedCode": null
    }
  ]
}
