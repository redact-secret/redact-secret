            "id": "allow-contextual",
            "match": {
              "type": [
                "contextual_secret"
              ]
            },
            "action": "allow"
          }
        ]
      }
    },
    {
      "id": "order-allow-first",
      "description": "Ordering conflict: a jwt finding at medium confidence matches both rules; the first wins.",
      "document": {
        "actionPolicyRevision": 1,
        "base": "default",
        "rules": [
          {
            "id": "allow-jwt",
            "match": {
              "type": [
                "jwt"
              ]
            },
            "action": "allow"
          },
          {
            "id": "block-medium",
            "match": {
              "confidence": [
                "medium"
              ]
            },
            "action": "block"
          }
        ]
      }
    },
    {
      "id": "order-block-first",
      "description": "The same two rules in the opposite order.",
      "document": {
        "actionPolicyRevision": 1,
        "base": "default",
        "rules": [
          {
            "id": "block-medium",
            "match": {
              "confidence": [
                "medium"
              ]
            },
            "action": "block"
          },
          {
            "id": "allow-jwt",
            "match": {
              "type": [
                "jwt"
              ]
            },
            "action": "allow"
          }
        ]
      }
    },
    {
      "id": "default-carve-out",
      "description": "The rule action `default` stops evaluation and returns the base action: an exception to a later broader rule.",
      "document": {
        "actionPolicyRevision": 1,
        "base": "default",
        "rules": [
          {
            "id": "keep-default-jwt",
            "match": {
              "type": [
                "jwt"
              ]
            },
            "action": "default"
          },
          {
            "id": "allow-medium",
            "match": {
              "confidence": [
                "medium"
              ]
            },
            "action": "allow"
          }
        ]
      }
    },
    {
      "id": "names-not-yet-emitted",
      "description": "Rules naming a type and a detector no built-in emits: the document loads, and matches only when such a finding exists.",
      "document": {
        "actionPolicyRevision": 1,
        "base": "default",
        "rules": [
          {
            "id": "future-type",
            "match": {
              "type": [
                "acme-not-yet-emitted"
              ]
