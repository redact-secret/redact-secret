  "acceptedDocuments": [
    {
      "id": "never-co-occurring-type-and-detector",
      "document": {
        "actionPolicyRevision": 1,
        "base": "default",
        "rules": [
          {
            "id": "odd-pair",
            "match": {
              "type": [
                "jwt"
              ],
              "detector": [
                "github-token"
              ]
            },
            "action": "block"
          }
        ]
      },
      "note": "Open sets: the core cannot know that no detector emits this pair, so it loads and never matches. Contradiction is not a load error."
    },
    {
