{
  "$schema": "action-policy-v1",
  "schemaVersion": 1,
  "contract": "docs/decisions/2026-10-06-define-the-versioned-declarative-action-policy-and-default-overlay.md",
  "description": "The reference conformance fixture for the revision 1 declarative action policy (issue #1217). It is data only and carries no implementation. Every surface that accepts an action policy runs it as part of the shared behavioral contract: the Rust core (semantics, through `evaluations` and `rejections`), then the Node addon, the WebAssembly artifact, the Python binding and the CLI (plumbing, through the public API and `endToEnd`). Every finding, document and input here is synthetic; nothing reproduces a real credential. `base` is a sentinel, never a literal action: a runner resolves it by asking its own surface's default evaluation of the same finding, so this file copies no part of the default table.",
  "revision": 1,
  "baseSentinel": "base",
  "limits": {
    "maxDocumentBytes": 65536,
    "maxRules": 128,
    "maxSetMembers": 256
  },
  "vocabulary": {
    "matchKeys": [
      "type",
      "detector",
      "confidence",
      "obfuscation"
    ],
    "actions": [
      "redact",
      "block",
      "warn",
      "allow"
    ],
    "ruleActions": [
      "redact",
      "block",
      "warn",
      "allow",
      "default"
    ],
    "confidence": [
      "high",
      "medium",
      "low"
    ],
    "obfuscation": [
      "none",
      "invisible-characters"
    ]
  },
  "errorCode": "INVALID_ACTION_POLICY",
  "errorMessage": "The supplied action policy is invalid.",
  "findings": {
    "private-key-high": {
      "type": "private_key",
      "detector": "private-key",
      "confidence": "high",
      "obfuscation": "none"
    },
    "github-high": {
      "type": "github_token",
      "detector": "github-token",
      "confidence": "high",
      "obfuscation": "none"
    },
    "github-high-invisible": {
      "type": "github_token",
      "detector": "github-token",
      "confidence": "high",
      "obfuscation": "invisible-characters"
    },
    "jwt-medium": {
      "type": "jwt",
      "detector": "jwt",
      "confidence": "medium",
      "obfuscation": "none"
    },
    "bearer-high": {
      "type": "bearer_token",
      "detector": "bearer-token",
      "confidence": "high",
      "obfuscation": "none"
    },
    "contextual-high": {
      "type": "contextual_secret",
      "detector": "generic-token",
      "confidence": "high",
      "obfuscation": "none"
    },
    "contextual-medium": {
      "type": "contextual_secret",
      "detector": "generic-token",
      "confidence": "medium",
      "obfuscation": "none"
    },
    "contextual-low": {
      "type": "contextual_secret",
      "detector": "generic-token",
      "confidence": "low",
      "obfuscation": "none"
    },
    "ruleset-medium": {
      "type": "acme-alnum-token",
      "detector": "acme-alnum-token",
      "confidence": "medium",
      "obfuscation": "none"
    },
    "unknown-high": {
      "type": "acme-future-type",
      "detector": "acme-future-detector",
      "confidence": "high",
      "obfuscation": "none"
    },
    "unknown-medium": {
      "type": "acme-future-type",
      "detector": "acme-future-detector",
      "confidence": "medium",
      "obfuscation": "none"
    },
    "future-named-high": {
      "type": "acme-not-yet-emitted",
      "detector": "acme-not-yet-detector",
      "confidence": "high",
      "obfuscation": "none"
    },
    "future-detector-only-high": {
      "type": "acme-other-type",
      "detector": "acme-not-yet-detector",
      "confidence": "high",
      "obfuscation": "none"
    }
  },
  "baseAnchors": {
    "description": "Findings whose default action an accepted decision freezes, so a runner whose `base` resolution is broken fails visibly. These are anchors, not the default table.",
    "cases": [
      {
        "finding": "private-key-high",
        "expectedAction": "block",
        "source": "default_action_for: private_key always blocks"
      },
      {
        "finding": "jwt-medium",
        "expectedAction": "redact",
        "source": "decision-keep-credential-role-facts-out-of-detection-attribution-and-default-action, item 3"
      },
      {
        "finding": "contextual-high",
        "expectedAction": "redact",
        "source": "the same item: contextual_secret redacts at high confidence"
      },
      {
        "finding": "contextual-medium",
        "expectedAction": "warn",
        "source": "the same item: contextual_secret warns at medium confidence"
      },
      {
        "finding": "ruleset-medium",
        "expectedAction": "warn",
        "source": "decision-define-declarative-ruleset-revisioning, item 8"
      },
      {
        "finding": "unknown-high",
        "expectedAction": "redact",
        "source": "a type no list names redacts at high confidence"
      },
      {
        "finding": "unknown-medium",
        "expectedAction": "warn",
        "source": "a type no list names warns below high confidence"
      }
    ]
  },
  "policies": [
    {
      "id": "empty-rules",
      "description": "No rules: the document is the explicit default base and nothing else.",
      "document": {
        "actionPolicyRevision": 1,
        "base": "default",
        "rules": []
      }
    },
    {
      "id": "exact-type",
      "description": "One exact type override.",
      "document": {
        "actionPolicyRevision": 1,
        "base": "default",
        "rules": [
