      "document": {
        "actionPolicyRevision": 1,
        "base": "default",
        "rules": [
          {
            "id": "warn-everything",
            "match": {
              "confidence": [
                "high",
                "medium",
                "low"
              ]
            },
            "action": "warn"
          }
        ]
      }
    }
