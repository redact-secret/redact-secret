{
  "schemaVersion": 1,
  "contract": "docs/reference/mcp-resources-read.md",
  "baseContract": "docs/reference/mcp-boundary.md",
  "note": "Supported MCP resources/read boundary cases (issue #843), a thin specialization of the MCP boundary fixture (#612) and the AI-context boundary fixture (#610). Every value is synthetic and already used by mcp-boundary.json: the ghp_SYNTHETICREVOKED token and the private-key body come from synchronous-corpus.json; synthetic-not-a-secret is detected only by its key context, which the key-aware sanitizeValue (#842) redacts in place; 9f8e7d6c5b4a39281706f5e4d3c2b1a0 is detected only through a sibling key, which only the serialized backstop sees. A text of the form {repeat, count} is materialized by the runner. All inputs are ASCII. Runner: conformance/mcp-resources-read.mjs.",
  "limits": {
    "wholeInput": {
      "maxInputBytes": 4096,
      "maxFindings": 16
    },
    "incremental": {
      "maxInputBytes": 4096,
      "maxBufferedBytes": 2176,
      "maxTokenBytes": 1024,
      "maxMultilineBytes": 2048
    },
    "traversal": {
      "maxDepth": 6,
      "maxNodes": 64
    }
  },
  "label": "resource",
  "safeFindingFields": [
    "id",
    "type",
    "detector",
    "confidence",
    "action",
    "obfuscation",
    "start",
    "end"
  ],
  "fixedErrors": {
    "blocked": {
      "code": -32603,
      "message": "This MCP resource read was blocked by secret-redaction policy. No content, URI, or error detail is included."
    },
    "readError": {
      "code": -32603,
      "message": "This MCP resource read failed. No content, URI, or error detail is included."
    }
  },
