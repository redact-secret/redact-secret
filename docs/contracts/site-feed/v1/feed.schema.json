{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/redact-secret/redact-secret/blob/main/docs/contracts/site-feed/v1/feed.schema.json",
  "title": "Redact Secret public site feed v1",
  "description": "Release identity and support matrix a public site may claim, generated by scripts/generate-site-feed.py from the durable release record and the pinned support matrix. Every string is bounded by a pattern: the feed carries identifiers, versions, digests, and short family names, never free text or a credential value.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "sources", "release", "supportMatrix"],
  "properties": {
    "schemaVersion": { "const": "redact-secret.site-feed/v1" },
    "generatedAt": {
      "description": "The latest timestamp carried by the inputs (never wall-clock time), UTC, second precision.",
      "$ref": "#/$defs/instant"
    },
    "sources": {
      "description": "The input files, as paths in this repository at the same commit as the feed, with the sha256 of their bytes.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": { "enum": ["release-manifest", "support-matrix"] },
          "path": { "type": "string", "pattern": "^(docs/releases/[0-9A-Za-z.-]{5,40}/manifest\\.json|benchmarks/support-matrix\\.json)$" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "release": {
      "description": "The highest released version with a final durable record under docs/releases/.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tag", "sourceRevision", "verifiedOn", "packages"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "tag": { "type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]{1,32})?$" },
        "sourceRevision": { "$ref": "#/$defs/sha40" },
        "verifiedOn": {
          "description": "The date the release record's independent registry verification was observed.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ecosystem", "name", "version"],
            "properties": {
              "ecosystem": { "enum": ["npm", "crates", "pypi"] },
              "name": { "type": "string", "pattern": "^(@redact-secret/)?[a-z0-9][a-z0-9-]{0,63}$" },
              "version": {
                "description": "The version as the registry spells it: SemVer for npm and crates, PEP 440 for PyPI.",
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-.]?[0-9A-Za-z.]{1,32})?$"
              }
            }
          }
        }
      }
    },
    "supportMatrix": {
      "description": "The pinned benchmarks/support-matrix.json, reduced to what a site may state.",
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmarksRevision", "generatedAt", "measuredProductVersion", "measuredProductRevision", "gatedLatestRelease", "providerCount", "familyCount", "distribution", "families"],
      "properties": {
        "benchmarksRevision": { "$ref": "#/$defs/sha40" },
        "generatedAt": { "$ref": "#/$defs/instant" },
        "measuredProductVersion": {
          "description": "The product version the benchmark run measured; it can be older than release.version.",
          "type": ["string", "null"],
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]{1,32})?$"
        },
        "measuredProductRevision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "gatedLatestRelease": {
          "description": "True when release.version's support-matrix drift gate ran against exactly this matrix.",
          "type": "boolean"
        },
        "providerCount": { "type": "integer", "minimum": 0 },
        "familyCount": { "type": "integer", "minimum": 1 },
        "distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stable", "provisional", "pending", "unsupported"],
          "properties": {
            "stable": { "type": "integer", "minimum": 0 },
            "provisional": { "type": "integer", "minimum": 0 },
            "pending": { "type": "integer", "minimum": 0 },
            "unsupported": { "type": "integer", "minimum": 0 }
          }
        },
        "families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "family", "name", "status", "evidenceTier", "qualificationProfile"],
            "properties": {
              "provider": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
              "family": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}:[a-z0-9][a-z0-9-]{0,63}$" },
              "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ()/,._+-]{0,79}$" },
              "status": { "enum": ["stable", "provisional", "pending", "unsupported"] },
              "evidenceTier": { "enum": ["T0", "T1", "T2", "T3", null] },
              "qualificationProfile": { "enum": ["documented", "empirical", null] }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "instant": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]{1,32})?$" }
  }
}
