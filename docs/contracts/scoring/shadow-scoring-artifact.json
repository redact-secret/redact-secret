  "knownLimitations": [
    {
      "id": "validation-cap-placeholder",
      "statement": "The validation group has no signal. Its cap of 50 is a placeholder that calibration did not fit. Context (50) plus validation (50) would reach high (51) with no randomness at all, so adding any validation signal needs a refit and a new model identity."
    },
