+    const RULESET_PROTOTYPE_MEASUREMENT_SAMPLE: &[u8] = b"ruleset-revision: 1\ndetector: acme-internal-token\nspecificity: contextual\nprefix: \"ACME_\"\nalphabet: alnum-dash\nrun: at-least 20\nvalidator: none\n";
+    if !std::hint::black_box(redact_secret::__ruleset_prototype_probe(
+        std::hint::black_box(RULESET_PROTOTYPE_MEASUREMENT_SAMPLE),
+    )) {
+        return Err(to_js_error(crate::error::WasmErrorCode::InitializationFailed));
+    }
     lifecycle::initialize().map_err(to_js_error)
 }
 
