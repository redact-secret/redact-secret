{
  "cases": [
    {
      "name": "nested_objects",
      "input": { "a": { "b": { "c": "no secret here" } } },
      "expected": { "a": { "b": { "c": "no secret here" } } }
    },
    {
      "name": "arrays",
      "input": ["plain", "SECRET_TOKEN_1 embedded", "plain2"],
      "expected": ["plain", "<SECRET_1> embedded", "plain2"]
    },
    {
      "name": "chat_message_array",
      "input": [
        { "role": "user", "content": "hi SECRET_TOKEN_1 there" },
        { "role": "assistant", "content": "ok" }
      ],
      "expected": [
        { "role": "user", "content": "hi <SECRET_1> there" },
        { "role": "assistant", "content": "ok" }
      ]
    },
    {
      "name": "tool_call_arguments_and_results",
      "input": {
        "tool_calls": [
          {
            "name": "lookup",
            "arguments": { "query": "find BLOCK_ME please" },
            "result": { "status": "ok", "data": "value SECRET_TOKEN_2 here" }
          }
        ]
      },
      "expected": {
        "tool_calls": [
          {
            "name": "lookup",
            "arguments": { "query": "[REDACTED:BLOCKED]" },
            "result": { "status": "ok", "data": "value <SECRET_1> here" }
          }
        ]
      }
    },
    {
      "name": "unicode",
      "input": { "message": "café 🔑 SECRET_TOKEN_3 中文" },
      "expected": { "message": "café 🔑 <SECRET_1> 中文" }
    },
    {
      "name": "warn_untouched",
      "input": { "note": "WARN_ME please keep visible" },
      "expected": { "note": "WARN_ME please keep visible" }
    },
    {
      "name": "mixed_scalars_untouched",
      "input": { "count": 42, "active": true, "missing": null, "label": "no secret" },
      "expected": { "count": 42, "active": true, "missing": null, "label": "no secret" }
    }
  ]
}
